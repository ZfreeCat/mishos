TZ=America/Chicago
PORT=3000
DB_URL=username:password@tcp(db_ipaddress:3306)/mishosgo?charset=utf8mb4&parseTime=True&loc=Local
SECRET=YOUR_SECRET_KEY
WATCHLIST_RECENT_LIMIT=10

# TMDB (required for the TMDB watchlist sync + Discover/recommendations feature)
# Get an API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# api.themoviedb.org is not reachable from mainland China - point at a proxy if needed
# TMDB_API_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_URL=https://image.tmdb.org/t/p

# Local image cache (tvmaze/tmdb images are cached locally because the CDNs
# are unreachable from mainland China)
IMAGE_CACHE_DIR=./data/images
# extra download-allowed image domains, comma separated
IMAGE_ALLOWED_DOMAINS=

# Scheduled task overrides
# CRON_TMDB_SYNC=0 3 * * *
# CRON_IMAGE_PREFETCH=0 4 * * *
